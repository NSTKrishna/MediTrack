# Copy to .env.local for local development. Never commit real values or service-account keys.
# For EAS builds, set these per environment (development / preview / production) with
#   eas env:create --environment <env> --name EXPO_PUBLIC_FIREBASE_API_KEY --value ...

# development | staging | production — selects bundle ID, app name, and URL scheme.
APP_VARIANT=development
EXPO_PUBLIC_APP_ENV=development
# Your organisation's reverse-DNS identifier (production uses it as-is; others add .dev/.staging).
APP_BUNDLE_ID=com.meditrack.app
# Required for caregiver push notifications (from `eas init`).
EAS_PROJECT_ID=

# Firebase web configuration identifies the client app; it is not a secret or a service account.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional, development only: point the app at the local Firestore emulator (e.g. 10.0.2.2 from
# the Android emulator, or your machine's LAN IP from a device). Ignored in production builds.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
